{
  "name": "real-time-insight-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Universal real-time insight engine with Node-RED integration",
  "license": "UNLICENSED",
  "packageManager": "npm@10.3.0",
  "engines": {
    "node": ">=18",
    "npm": ">=7"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run clean && tsc -b",
    "clean": "node -e \"const fs=require('node:fs');for(const dir of fs.readdirSync('packages'))fs.rmSync('packages/'+dir+'/dist',{recursive:true,force:true})\"",
    "format": "prettier --write \"*.{json,mjs,ts}\" \"packages/**/*.{json,ts}\"",
    "format:check": "prettier --check \"*.{json,mjs,ts}\" \"packages/**/*.{json,ts}\"",
    "lint": "eslint \"packages/**/*.ts\" --max-warnings 0",
    "benchmark": "node scripts/runtime-benchmark.cjs",
    "pack:palette": "npm run build && node scripts/build-palette-package.cjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.check.json",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "workspaces:list": "npm query .workspace"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^18.19.130",
    "@types/node-red": "1.3.5",
    "@types/node-red-node-test-helper": "0.3.5",
    "eslint": "^9.39.5",
    "node-red": "3.0.2",
    "node-red-node-test-helper": "0.3.6",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  }
}
